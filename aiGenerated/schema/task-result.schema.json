{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sunshine Blackboard AI Task Result",
  "type": "object",
  "required": ["taskType", "requestId", "version", "source", "input", "data", "createdAt"],
  "properties": {
    "taskType": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "source": {
      "type": "string",
      "enum": ["chatgpt", "manual", "imported"]
    },
    "input": {
      "type": "object"
    },
    "data": {},
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
