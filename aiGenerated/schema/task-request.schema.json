{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sunshine Blackboard AI Task Request",
  "type": "object",
  "required": ["taskType", "requestId", "version", "input"],
  "properties": {
    "taskType": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "input": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
